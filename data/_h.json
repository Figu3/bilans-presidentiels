dent.fr/francois-hollande/","statut":"partiel"},{"src":"L'Obs 2014","url":"https://web.archive.org/web/20161201015716/http://tempsreel.nouvelobs.com/politique/20141105.OBS4169/infographie-a-mi-mandat-que-sont-devenues-les-60-promesses-de-hollande.html","statut":"en_cours"}]},{"n":38,"theme":"Éducation","engagement":"Priorité au primaire ; réforme des rythmes scolaires","statut":"tenu","note":"Semaine de 4,5 jours instaurée par le décret de janvier 2013.","sources":["https://www.luipresident.fr/francois-hollande/engagement/modification-des-rythmes-scolaires-41"],"flag":false,"verdicts":[{"src":"Lui Président","url":"https://www.luipresident.fr/francois-hollande/","statut":"tenu"},{"src":"L'Obs 2014","url":"https://web.archive.org/web/20161201015716/http://tempsreel.nouvelobs.com/politique/20141105.OBS4169/infographie-a-mi-mandat-que-sont-devenues-les-60-promesses-de-hollande.html","statut":"tenu"}]},{"n":39,"theme":"Éducation","engagement":"Réformer l'université, encadrer les stages, abroger la circulaire Guéant","statut":"tenu","note":"Circulaire abrogée (mai 2012), loi Fioraso (2013), loi sur les stages (2014) ; l'allocation d'études est abandonnée.","sources":["https://www.luipresident.fr/francois-hollande/engagement/reforme-des-premiers-cycles-duniversite-42"],"flag":true,"verdicts":[{"src":"Lui Président","url":"https://www.luipresident.fr/francois-hollande/","statut":"tenu"},{"src":"L'Obs 2014","url":"https://web.archive.org/web/20161201015716/http://tempsreel.nouvelobs.com/politique/20141105.OBS4169/infographie-a-mi-mandat-que-sont-devenues-les-60-promesses-de-hollande.html","statut":"tenu"}]},{"n":40,"theme":"Culture","engagement":"Garantir la pratique sportive en club pour tous les jeunes","statut":"partiel","note":"Mesures ponctuelles sans garantie d'accès ; Euro 2016 accueilli, candidature JO 2024 lancée.","sources":["https://www.luipresident.fr/francois-hollande/engagement/garantir-pratique-du-sport-50"],"flag":false,"verdicts":[{"src":"Lui Président","ur