ident.fr/francois-hollande/","statut":"non_tenu"},{"src":"L'Obs 2014","url":"https://web.archive.org/web/20161201015716/http://tempsreel.nouvelobs.com/politique/20141105.OBS4169/infographie-a-mi-mandat-que-sont-devenues-les-60-promesses-de-hollande.html","statut":"non_tenu"}]},{"n":31,"theme":"Société","engagement":"Ouvrir le mariage et l'adoption aux couples homosexuels","statut":"tenu","note":"Loi du 17 mai 2013.","sources":["https://www.luipresident.fr/francois-hollande/engagement/mariage-homosexuel-18"],"flag":false,"verdicts":[{"src":"Lui Président","url":"https://www.luipresident.fr/francois-hollande/","statut":"tenu"},{"src":"L'Obs 2014","url":"https://web.archive.org/web/20161201015716/http://tempsreel.nouvelobs.com/politique/20141105.OBS4169/infographie-a-mi-mandat-que-sont-devenues-les-60-promesses-de-hollande.html","statut":"tenu"},{"src":"franceinfo 2016","url":"https://www.franceinfo.fr/elections/presidentielle/sept-promesses-que-francois-hollande-a-tenues-depuis-2012_1432753.html","statut":"tenu"},{"src":"Contrepoints 2017","url":"https://contrepoints-archives.org/retenir-mandat-de-francois-hollande","statut":"tenu"},{"src":"JDD","url":"https://www.lejdd.fr/Politique/Mariage-pour-tous-promesse-tenue-606145-3138893","statut":"tenu"}]},{"n":32,"theme":"Société","engagement":"Volet handicap dans chaque loi ; quota de 6 % mieux sanctionné","statut":"partiel","note":"Circulaire de 2012 sur le volet handicap ; sanctions sur le quota non renforcées.","sources":["https://www.luipresident.fr/francois-hollande/engagement/volet-handicap-dans-chaque-loi-21"],"flag":false,"verdicts":[{"src":"Lui Président","url":"https://www.luipresident.fr/francois-hollande/","statut":"partiel"},{"src":"L'Obs 2014","url":"https://web.archive.org/web/20161201015716/http://tempsreel.nouvelobs.com/politique/20141105.OBS4169/infographie-a-mi-mandat-que-sont-devenues-les-60-promesses-de-hollande.html","statut":"en_cours"}]},{"n":33,"theme":"Emploi","engagement":"Contrat de génération :